PORT=5050
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/aml_db
# For MongoDB Atlas (Free Cloud Cluster):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aml_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
ML_SERVICE_URL=http://127.0.0.1:5000
NODE_ENV=production
